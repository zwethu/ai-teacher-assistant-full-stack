# MILA backend — local development template.
# Copy to .env and fill the two <ASK-A-TEAMMATE> values. .env is gitignored.
#
# Authentication is KEYLESS. Do NOT set GOOGLE_APPLICATION_CREDENTIALS or
# FIREBASE_SERVICE_ACCOUNT — leaving them unset is what makes the app use
# Application Default Credentials. Run once, before starting the server:
#
#   gcloud auth application-default login
#   gcloud auth application-default set-quota-project project-84d32b41-da8b-4f57-b15
#
# You also need roles/iam.serviceAccountTokenCreator on the project, or the OAuth
# callback fails: with no private key, custom tokens are signed via IAM SignBlob.

# --- GCP / Firebase (all one project now) ---
GOOGLE_CLOUD_PROJECT=project-84d32b41-da8b-4f57-b15
FIREBASE_PROJECT_ID=project-84d32b41-da8b-4f57-b15
FIREBASE_RTDB_URL=https://project-84d32b41-da8b-4f57-b15-default-rtdb.asia-southeast1.firebasedatabase.app/
# Identity firebase_admin signs custom tokens as (via IAM SignBlob).
FIREBASE_SERVICE_ACCOUNT_ID=mila-agent@project-84d32b41-da8b-4f57-b15.iam.gserviceaccount.com

# --- Storage & retrieval ---
GCS_BUCKET_NAME=mila-mfu-files
VERTEX_ROOT_DATASTORE_ID=projects/project-84d32b41-da8b-4f57-b15/locations/global/collections/default_collection/dataStores/mila-root-tenant

# --- Agent Engine ---
AGENT_ENGINE_RESOURCE_NAME=projects/261097120406/locations/us-central1/reasoningEngines/1642698409443852288
AGENT_ENGINE_LOCATION=us-central1
# Cosmetic: sessions key on the Agent Engine resource id, not this string.
AGENT_APP_NAME=pnai-teacher-assistant

# --- Google Workspace OAuth (client "MILA Backend (Workspace)") ---
GOOGLE_CLIENT_ID=261097120406-3t4e9hkhupa6jdv2nrf6n42ps9vsblk6.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=<ASK-A-TEAMMATE>
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google-scopes/callback
FRONTEND_URL=http://localhost:5173

# --- Internal ---
# Shared secret for Agent Engine <-> backend internal endpoints.
PNAI_AGENT_SHARED_SECRET=<ASK-A-TEAMMATE>
# Local cron opt-out; in production Cloud Scheduler drives the sweeps instead.
MAINTENANCE_SCHEDULER_ENABLED=false
