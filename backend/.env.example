# Firebase (Admin SDK — token verification; optional privileged writes)
FIREBASE_PROJECT_ID=

# Google OAuth (server-only — used for Gmail / Calendar / Forms scopes)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google-scopes/callback
FRONTEND_URL=http://localhost:5173

# GCP Agent Engine (optional — only if you proxy from backend instead of React)
AGENT_ENGINE_BASE_URL=
AGENT_ENGINE_RESOURCE_NAME=

# App
SECRET_KEY=
APP_ENV=development
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
