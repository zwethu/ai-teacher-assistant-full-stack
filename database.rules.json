{
  "rules": {
    ".read": false,
    ".write": false,

    "agentRuns": {
      // Backend + agent write via the Admin SDK (rules bypassed). Clients get
      // read-only access to a run only if they own it, established by the
      // backend-written meta/lecturer_id. No client writes.
      "$run_id": {
        ".read": "auth != null && data.child('meta/lecturer_id').val() === auth.uid",
        ".write": false
      }
    },

    "chatAttachments": {
      // Processing status for a chat's attachments, so the composer can subscribe
      // instead of polling an HTTP endpoint every 2.5s. Same ownership model as
      // agentRuns: the backend writes meta/lecturer_id via the Admin SDK and the
      // rule reads it back. Read-only for clients; the Firestore document remains
      // the source of truth.
      "$chat_id": {
        ".read": "auth != null && data.child('meta/lecturer_id').val() === auth.uid",
        ".write": false
      }
    }
  }
}
