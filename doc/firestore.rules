rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Documents scoped by a top-level "uid" field (must match the signed-in user).
    function isOwner() {
      return signedIn() && resource.data.uid == request.auth.uid;
    }

    function isOwnerOnCreate() {
      return signedIn() && request.resource.data.uid == request.auth.uid;
    }

    function isOwnerOnUpdate() {
      return signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid;
    }

    match /users/{userId} {
      allow read, create, update, delete: if signedIn() && request.auth.uid == userId;
    }

    match /assessments/{docId} {
      allow get, list: if isOwner();
      allow create: if isOwnerOnCreate();
      allow update: if isOwnerOnUpdate();
      allow delete: if isOwner();
    }

    match /batches/{batchId} {
      allow get, list: if isOwner();
      allow create: if isOwnerOnCreate();
      allow update: if isOwnerOnUpdate();
      allow delete: if isOwner();

      match /students/{studentId} {
        function batchOwner() {
          return signedIn()
            && get(/databases/$(database)/documents/batches/$(batchId)).data.uid
               == request.auth.uid;
        }
        allow get, list: if batchOwner();
        allow create: if batchOwner();
        allow update, delete: if batchOwner();
      }
    }

    match /lesson_plans/{docId} {
      allow get, list: if isOwner();
      allow create: if isOwnerOnCreate();
      allow update: if isOwnerOnUpdate();
      allow delete: if isOwner();
    }

    match /wellness/{docId} {
      allow get, list: if isOwner();
      allow create: if isOwnerOnCreate();
      allow update: if isOwnerOnUpdate();
      allow delete: if isOwner();
    }

    // Stress score per user (document id = Firebase Auth uid).
    match /user_stress/{uid} {
      allow read, create, update, delete: if signedIn() && request.auth.uid == uid;
    }

    // Post-breathing journal entries (scoped by uid field).
    match /wellness_journal/{docId} {
      allow get, list: if isOwner();
      allow create: if isOwnerOnCreate();
      allow update: if isOwnerOnUpdate();
      allow delete: if isOwner();
    }

    match /timetable/{docId} {
      allow get, list: if isOwner();
      allow create: if isOwnerOnCreate();
      allow update: if isOwnerOnUpdate();
      allow delete: if isOwner();
    }

    match /emails/{docId} {
      allow get, list: if isOwner();
      allow create: if isOwnerOnCreate();
      allow update: if isOwnerOnUpdate();
      allow delete: if isOwner();
    }

    // The countdown's anchor: one doc per player per assessment, holding the
    // server's stamp of when their run began. The client reads this back to
    // work out how much time is really left, so these rules — not the app code
    // — are what actually stop the clock being reset. Three things matter:
    //   · startedAt must BE the server's time (== request.time), not a value
    //     the client picked
    //   · startedAt can never be rewritten after create
    //   · the doc can never be deleted, since deleting it and re-creating is
    //     the same reset by another route
    match /gameRuns/{runId} {
      function ownRun(data) {
        return signedIn() && data.playerUid == request.auth.uid;
      }

      allow get: if ownRun(resource.data);

      allow create: if ownRun(request.resource.data)
        && runId == request.resource.data.assessmentId + '_' + request.auth.uid
        && request.resource.data.startedAt  == request.time
        && request.resource.data.lastSeenAt == request.time;

      // Resuming only ever touches lastSeenAt.
      allow update: if ownRun(resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastSeenAt'])
        && request.resource.data.lastSeenAt == request.time;

      allow delete: if false;
    }

    // Written only by the backend (Admin SDK). Block all client access.
    match /oauth_states/{docId} {
      allow read, write: if false;
    }
  }
}
