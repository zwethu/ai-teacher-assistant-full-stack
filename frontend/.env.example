# Firebase web config for the MILA project.
# These are client-side values (they ship in the JS bundle), but the real file is
# gitignored — copy this to .env and fill from:
#   Firebase console -> Project settings -> Your apps -> Web app -> SDK setup and config
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_DATABASE_URL=

# FastAPI backend
VITE_API_URL=http://localhost:8000

# Agent Engine is reached through the backend gateway; leave blank.
VITE_AGENT_ENGINE_URL=
